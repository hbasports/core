{
  "extends": "../tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@auth": ["./index.ts"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["src", "index.ts"],
  "exclude": ["dist", "build", "node_modules"]
}
