generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator zod {
  provider = "prisma-zod-generator"
}

type Image {
  href        String
  width       Int?
  height      Int?
  rel         String[]
  alt         String?
  lastUpdated DateTime
}

type FirstName {
  legal     String
  preferred String?
}

type FullName {
  firstName   FirstName
  middleNames String[]
  lastName    String
}

type Country {
  countryCode String
  country     String
  nationality String?
  display     String?
}

type Location {
  city    String?
  state   String?
  country Country
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

type BiometricData {
  heightCm Int
  weightKg Int
}

enum Handedness {
  RIGHT
  LEFT
  AMBIDEXTROUS
}

enum BowlingSpeed {
  FAST
  FAST_MEDIUM
  MEDIUM_FAST
  MEDIUM
  MEDIUM_SLOW
  SLOW_MEDIUM
  SLOW
}

enum BowlingStyle {
  ORTHODOX
  UNORTHODOX
  LEGBREAK_GOOGLY
  LEGBREAK
  OFFBREAK
}

type BowlingInfo {
  handedness Handedness
  speed      BowlingSpeed
  style      BowlingStyle?
}

enum PlayingRole {
  BOWLER
  BOWLING_ALLROUNDER
  ALLROUNDER
  BATTING_ALLROUNDER
  BATTER
  WICKETKEEPER_BATTER
}

model Cricketer {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  fullName     FullName
  biometric    BiometricData?
  born         BirthDetails
  nationality  Country
  bowlingStyle BowlingInfo?
  battingStyle Handedness
  playingRole  PlayingRole
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

type Colors {
  color          String
  alternateColor String
}

type BirthDetails {
  date     DateTime
  location Location
  gender   Gender
}

model Player {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  fullName      FullName
  birthDetails  BirthDetails
  biometricData BiometricData
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model CricketTeam {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  teamId           String
  name             String
  nickname         String
  abbreviation     String
  displayName      String
  shortDisplayName String
  slug             String
  gender           Gender
  colors           Colors?
  images           Image[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CricketVenue {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  suburb            String?
  city              String
  country           String?
  established       Int?
  capacity          Int?
  playingAreaWidth  Int?
  playingAreaHeight Int?
  endNames          String[]
  floodlights       Boolean? @default(false)
  curatorName       String? // Adjust to a record when integrated
  hoursFromUTC      String? // Example: '+3:30, -12', integrate daylight savings
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
