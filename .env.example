# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# This app natively uses MongoDB with Prisma. You will need to setup the codebase 
# to setup your preferred database provider.
DATABASE_URL=
 
# All the following variables are not defined but have defaults set at
# packages/lib/constants.ts
# Only set this variables if you wish to override the default values
API_PORT=
WEB_PORT=

NEXT_PUBLIC_WEBAPP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# @see https://next-auth.js.org/configuration/options#nextauth_secret
# You can use: `openssl rand -base64 32` to generate one
AUTH_SECRET=""

# Used for encrypting important information like user data
# You can use: `openssl rand -base64 24` to generate one
ENCRYPTION_KEY=

# Use the following to adjust your brand
NEXT_PUBLIC_APP_NAME="HBA Sports"
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS=""
NEXT_PUBLIC_COMPANY_NAME="HBA Sports, Inc."