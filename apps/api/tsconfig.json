{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@lib/*": ["./src/lib/*"],
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["dist"]
}
